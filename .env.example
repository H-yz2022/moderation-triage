# Leave empty to run fully offline with the mock provider.
ANTHROPIC_API_KEY=
# AI review is still in testing: keep this false and nothing calls the API, even with a key set.
MODTRIAGE_AI_ENABLED=false

# auto = anthropic if a key is set, else mock
MODTRIAGE_PROVIDER=auto
MODTRIAGE_SPECIALIST_MODEL=claude-haiku-4-5
MODTRIAGE_ARBITER_MODEL=claude-sonnet-5
# Set to true to make the metadata specialist an LLM call instead of $0 rules
MODTRIAGE_METADATA_LLM=false

# Routing: gate_only | single | majority | full | cascade
MODTRIAGE_MODE=cascade
# Worked policy examples go to: arbiter (default; cheapest) | all | none.
# Haiku only caches prompts >= 4096 tokens, so examples cost the specialists full price every call.
MODTRIAGE_POLICY_EXAMPLES=arbiter
# Items the local gate scores below this skip the LLM panel (set from `train-gate` output)
MODTRIAGE_GATE_ALLOW_BELOW=0.04
MODTRIAGE_REMOVE_THRESHOLD=0.45
MODTRIAGE_ALLOW_THRESHOLD=0.45
MODTRIAGE_ARBITER_MIN_CONFIDENCE=0.7
MODTRIAGE_HIGH_SEVERITY_ESCALATE_CONF=0.5

# Cost control
MODTRIAGE_RUN_BUDGET_USD=5.0
MODTRIAGE_MAX_DAILY_LLM_CALLS=2000
MODTRIAGE_MAX_TEXT_CHARS=4000
MODTRIAGE_USE_CACHE=true

# Agent vote weights from human reviews (written by `modtriage calibrate --write`); voting defaults if absent
# MODTRIAGE_WEIGHTS=data/models/agent_weights.json
